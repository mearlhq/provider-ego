{
  "name": "@mearl/provider-ego",
  "version": "0.1.5",
  "description": "Ego Lite browser discovery and Space lifecycle provider for Mearl",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/mearlhq/provider-ego.git" },
  "homepage": "https://github.com/mearlhq/provider-ego#readme",
  "bugs": { "url": "https://github.com/mearlhq/provider-ego/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "node": ">=22.23.4" },
  "packageManager": "pnpm@10.34.5",
  "files": ["dist", "README.md", "README.en.md"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node build.mjs --typecheck",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@mearl/provider": "3.1.4",
    "@mearl/browser-core": "3.1.4",
    "@mearl/preset": "3.1.4"
  },
  "devDependencies": { "@mearl/native-host": "3.1.4", "esbuild": "^0.28.2", "@types/node": "^24.9.1", "typescript": "^5.8.3", "vitest": "4.1.8" },
  "mearl": {
    "provider": {
      "providerId": "ego", "name": "Ego Lite", "protocolVersion": 3,
      "entry": "./dist/runtime.js",
      "browserType": {
        "name": "EgoLite", "controlSessionModes": ["external"],
        "help": [
          "已运行的 EgoLite 由 browser_list 发现。使用 session_manage new 创建或关联任务 Space。",
          "填写任务名称新建 Space，或用 spaceId 接入已有的 Agent Space。用户自己的 Space 不会被自动接管。",
          "用 session_manage 交还控制权（handoff）、恢复控制（resume）或结束任务（end）。结束时可用 keepTabIds 保留指定页面。仅在用户明确交回控制权后恢复。",
          "使用 sessionId 操作 Space 内的页面。扩展可用时优先执行支持的页面操作，Space 生命周期由 Ego 原生通道管理。"
        ],
        "inputSchema": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "taskSession": {
              "type": "object", "formHidden": true, "additionalProperties": false,
              "properties": { "browserId": { "type": "string", "enum": ["local"] } },
              "required": ["browserId"]
            },
            "name": {
              "type": "string", "minLength": 1, "title": "任务名称",
              "placeholder": "例如：整理网页资料",
              "description": "新建 Space 时填写；接入已有 Space 时留空。",
              "locales": {
                "en": {
                  "title": "Task name",
                  "placeholder": "For example, organize research notes",
                  "description": "Enter a name to create a Space. Leave blank to attach to an existing Space."
                }
              }
            },
            "spaceId": {
              "type": "number", "integer": true, "minimum": 0, "title": "已有 Space ID",
              "placeholder": "例如：123",
              "description": "仅支持接入 Agent 的 Space；新建时留空。",
              "locales": {
                "en": {
                  "title": "Existing Space ID",
                  "placeholder": "For example, 123",
                  "description": "Enter an Agent-owned Space ID. Leave blank to create a Space."
                }
              }
            }
          },
          "oneOf": [
            {"type": "object", "properties": {"name": {"type": "string"}, "taskSession": {"type": "object", "properties": {}, "additionalProperties": true}}, "required": ["name"], "additionalProperties": false},
            {"type": "object", "properties": {"spaceId": {"type": "number"}, "taskSession": {"type": "object", "properties": {}, "additionalProperties": true}}, "required": ["spaceId"], "additionalProperties": false},
            {"type": "object", "properties": {"taskSession": {"type": "object", "properties": {}, "additionalProperties": true}}, "required": ["taskSession"], "additionalProperties": false}
          ]
        }
      }
    }
  }
}
